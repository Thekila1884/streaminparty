rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if isMember(roomId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if isMember(roomId);
        allow create: if signedIn() && request.auth.uid == userId && exists(/databases/$(database)/documents/rooms/$(roomId));
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
