rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
    }

    match /publicRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isMember(roomId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if isMember(roomId);
        allow create, update: if signedIn()
          && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'attachmentUrl', 'attachmentName', 'attachmentType', 'createdAt']);
        allow delete: if isMember(roomId) && resource.data.senderId == request.auth.uid;
      }

      match /calls/{callId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.from == request.auth.uid;
        allow update: if isMember(roomId)
          && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid
            || request.resource.data.from == request.auth.uid
            || request.resource.data.to == request.auth.uid);
        allow delete: if isMember(roomId)
          && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      }
    }
  }
}
